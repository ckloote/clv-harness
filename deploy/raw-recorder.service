# systemd *user* unit for the R0 raw recorder (DESIGN.md §13 R0).
#
# Install:
#   mkdir -p ~/.config/systemd/user ~/.config/raw-recorder
#   cp deploy/raw-recorder.service ~/.config/systemd/user/
#   # secrets, chmod 600 (see README "Secrets"):
#   $EDITOR ~/.config/raw-recorder/env
#   systemctl --user daemon-reload
#   systemctl --user enable --now raw-recorder.service
#   loginctl enable-linger "$USER"   # keep running while logged out
#   journalctl --user -u raw-recorder -f
#   uv run raw-recorder status          # is the current game being captured?
#
# The recorder holds a sleep inhibitor itself while a capture window is open.
# Edit WorkingDirectory (and the ExecStart path) if the checkout lives elsewhere.
# `uv` must be on PATH.
#
# The recorder runs from the venv directly so it stays in this service's cgroup:
# its output, including startup warnings such as a missing key (at warning
# priority), is in `journalctl --user -u raw-recorder` and `systemctl --user
# status raw-recorder`, with real CPU and memory figures. Run through the uv snap
# (`uv run`), it lands in a transient snap scope instead, outside the unit's log.
# uv only syncs the venv first (--inexact keeps the dev tools installed).

[Unit]
Description=CLV harness R0 raw recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/code/clv-harness
EnvironmentFile=-%h/.config/raw-recorder/env
ExecStartPre=/usr/bin/env uv sync --inexact --package raw-recorder
ExecStart=%h/code/clv-harness/.venv/bin/raw-recorder run
# SIGTERM: the recorder emits process_stop and seals every active segment.
KillSignal=SIGTERM
TimeoutStopSec=60
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
