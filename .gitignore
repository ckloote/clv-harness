# Python bytecode caches, at any depth.
__pycache__/
# Virtual environment managed by uv.
.venv/
# Raw evidence archive: large, backed up separately, never committed. Root only: the
# synthetic golden game's archive under tests/fixtures/ is committed on purpose.
/archive/
# Secrets must never be committed.
*.pem
.env
# Novig Paper (play-money) test archive: never evidence, never committed.
archive-paper/
# B0 feasibility inputs and caches (tools/b0): large, re-fetchable, never committed.
b0-work/
# Harness databases: rebuilt from the archive (clv migrate / clv ingest).
data/
